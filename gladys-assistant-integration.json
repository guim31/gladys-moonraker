{
  "manifest_version": 1,
  "type": "device",
  "name": "Moonraker (Klipper)",
  "description": {
    "en": "Follow and control your Klipper 3D printers: progress, temperatures, alerts, macros.",
    "fr": "Suivez et pilotez vos imprimantes 3D Klipper : progression, températures, alertes, macros.",
    "de": "Verfolge und steuere deine Klipper-3D-Drucker: Fortschritt, Temperaturen, Alarme, Makros.",
    "es": "Siga y controle sus impresoras 3D Klipper: progreso, temperaturas, alertas, macros."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-moonraker:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-moonraker/main/cover.png",
  "categories": ["appliances"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect your Klipper printer",
        "fr": "Connecter votre imprimante Klipper",
        "de": "Verbinde deinen Klipper-Drucker",
        "es": "Conecte su impresora Klipper"
      },
      "description": {
        "en": "Enter the address of Moonraker: the IP address of the printer (port 7125 by default), or the address you open Mainsail or Fluidd with. An API key is only needed when Moonraker does not trust your network. Up to three printers.",
        "fr": "Saisissez l'adresse de Moonraker : l'adresse IP de l'imprimante (port 7125 par défaut), ou l'adresse avec laquelle vous ouvrez Mainsail ou Fluidd. Une clé d'API n'est utile que si Moonraker ne fait pas confiance à votre réseau. Jusqu'à trois imprimantes.",
        "de": "Gib die Adresse von Moonraker ein: die IP-Adresse des Druckers (standardmäßig Port 7125) oder die Adresse, mit der du Mainsail oder Fluidd öffnest. Ein API-Schlüssel ist nur nötig, wenn Moonraker deinem Netzwerk nicht vertraut. Bis zu drei Drucker.",
        "es": "Introduzca la dirección de Moonraker: la dirección IP de la impresora (puerto 7125 por defecto) o la dirección con la que abre Mainsail o Fluidd. Solo se necesita una clave de API si Moonraker no confía en su red. Hasta tres impresoras."
      }
    },
    {
      "key": "url_1",
      "type": "string",
      "label": {
        "en": "Moonraker address",
        "fr": "Adresse de Moonraker",
        "de": "Moonraker-Adresse",
        "es": "Dirección de Moonraker"
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50",
        "fr": "ex. 192.168.1.50",
        "de": "z. B. 192.168.1.50",
        "es": "p. ej. 192.168.1.50"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "api_key_1",
      "type": "secret",
      "label": {
        "en": "API key (optional)",
        "fr": "Clé d'API (facultatif)",
        "de": "API-Schlüssel (optional)",
        "es": "Clave de API (opcional)"
      },
      "description": {
        "en": "Mainsail: Settings, Authorization, API key. Fluidd: Settings, Authentication. Leave empty on a trusted network.",
        "fr": "Mainsail : Paramètres, Autorisation, clé d'API. Fluidd : Paramètres, Authentification. Laissez vide sur un réseau de confiance.",
        "de": "Mainsail: Einstellungen, Autorisierung, API-Schlüssel. Fluidd: Einstellungen, Authentifizierung. Leer lassen in einem vertrauenswürdigen Netzwerk.",
        "es": "Mainsail: Ajustes, Autorización, clave de API. Fluidd: Ajustes, Autenticación. Déjela vacía en una red de confianza."
      },
      "required": false
    },
    {
      "key": "section_2",
      "type": "section",
      "label": {
        "en": "Printer 2 (optional)",
        "fr": "Imprimante 2 (facultatif)",
        "de": "Drucker 2 (optional)",
        "es": "Impresora 2 (opcional)"
      }
    },
    {
      "key": "url_2",
      "type": "string",
      "label": {
        "en": "Moonraker address 2",
        "fr": "Adresse de Moonraker 2",
        "de": "Moonraker-Adresse 2",
        "es": "Dirección de Moonraker 2"
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50",
        "fr": "ex. 192.168.1.50",
        "de": "z. B. 192.168.1.50",
        "es": "p. ej. 192.168.1.50"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "api_key_2",
      "type": "secret",
      "label": {
        "en": "API key 2 (optional)",
        "fr": "Clé d'API 2 (facultatif)",
        "de": "API-Schlüssel 2 (optional)",
        "es": "Clave de API 2 (opcional)"
      },
      "required": false
    },
    {
      "key": "section_3",
      "type": "section",
      "label": {
        "en": "Printer 3 (optional)",
        "fr": "Imprimante 3 (facultatif)",
        "de": "Drucker 3 (optional)",
        "es": "Impresora 3 (opcional)"
      }
    },
    {
      "key": "url_3",
      "type": "string",
      "label": {
        "en": "Moonraker address 3",
        "fr": "Adresse de Moonraker 3",
        "de": "Moonraker-Adresse 3",
        "es": "Dirección de Moonraker 3"
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50",
        "fr": "ex. 192.168.1.50",
        "de": "z. B. 192.168.1.50",
        "es": "p. ej. 192.168.1.50"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "api_key_3",
      "type": "secret",
      "label": {
        "en": "API key 3 (optional)",
        "fr": "Clé d'API 3 (facultatif)",
        "de": "API-Schlüssel 3 (optional)",
        "es": "Clave de API 3 (opcional)"
      },
      "required": false
    },
    {
      "key": "section_options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      },
      "description": {
        "en": "Language of the names and texts the integration creates (feature names are set when a device is added).",
        "fr": "Langue des noms et textes créés par l'intégration (les noms des fonctionnalités sont fixés à l'ajout de l'appareil).",
        "de": "Sprache der Namen und Texte, die die Integration erzeugt (Funktionsnamen werden beim Hinzufügen des Geräts festgelegt).",
        "es": "Idioma de los nombres y textos que crea la integración (los nombres de las funciones se fijan al añadir el dispositivo)."
      }
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language",
        "fr": "Langue",
        "de": "Sprache",
        "es": "Idioma"
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "State of each printer and the list of its macros.",
        "fr": "État de chaque imprimante et liste de ses macros.",
        "de": "Status jedes Druckers und Liste seiner Makros.",
        "es": "Estado de cada impresora y lista de sus macros."
      },
      "timeout_seconds": 15
    }
  ],
  "scene_triggers": [
    {
      "key": "print_started",
      "label": {
        "en": "Print started",
        "fr": "Impression démarrée",
        "de": "Druck gestartet",
