  "scene_actions": [
    {
      "key": "control_print",
      "label": {
        "en": "Pause, resume or cancel a print",
        "fr": "Mettre en pause, reprendre ou annuler une impression",
        "de": "Druck pausieren, fortsetzen oder abbrechen",
        "es": "Pausar, reanudar o cancelar una impresión"
      },
      "description": {
        "en": "Applied: false when there is nothing to pause, resume or cancel.",
        "fr": "Appliqué : faux quand il n'y a rien à mettre en pause, reprendre ou annuler.",
        "de": "Ausgeführt: falsch, wenn nichts zu pausieren, fortzusetzen oder abzubrechen ist.",
        "es": "Aplicado: falso cuando no hay nada que pausar, reanudar o cancelar."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Printer",
            "fr": "Imprimante",
            "de": "Drucker",
            "es": "Impresora"
          },
          "required": true
        },
        {
          "key": "command",
          "type": "select",
          "label": {
            "en": "Command",
            "fr": "Commande",
            "de": "Befehl",
            "es": "Comando"
          },
          "required": true,
          "default": "pause",
          "options": [
            {
              "value": "pause",
              "label": {
                "en": "Pause",
                "fr": "Mettre en pause",
                "de": "Pausieren",
                "es": "Pausar"
              }
            },
            {
              "value": "resume",
              "label": {
                "en": "Resume",
                "fr": "Reprendre",
                "de": "Fortsetzen",
                "es": "Reanudar"
              }
            },
            {
              "value": "cancel",
              "label": {
                "en": "Cancel",
                "fr": "Annuler",
                "de": "Abbrechen",
                "es": "Cancelar"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "applied",
          "type": "boolean",
          "label": {
            "en": "Applied",
            "fr": "Appliqué",
            "de": "Ausgeführt",
            "es": "Aplicado"
          }
        }
      ]
    },
    {
      "key": "preheat",
      "label": {
        "en": "Preheat the printer",
        "fr": "Préchauffer l'imprimante",
        "de": "Drucker vorheizen",
        "es": "Precalentar la impresora"
      },
      "description": {
        "en": "Sets the targets of every nozzle and of the bed, within Klipper's limits. Refused during a print (applied: false).",
        "fr": "Règle les consignes de toutes les buses et du plateau, dans les limites de Klipper. Refusé pendant une impression (appliqué : faux).",
        "de": "Setzt die Solltemperaturen aller Düsen und des Druckbetts, innerhalb der Grenzen von Klipper. Während eines Drucks abgelehnt (ausgeführt: falsch).",
        "es": "Fija las consignas de todas las boquillas y de la cama, dentro de los límites de Klipper. Se rechaza durante una impresión (aplicado: falso)."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Printer",
            "fr": "Imprimante",
            "de": "Drucker",
            "es": "Impresora"
          },
          "required": true
        },
        {
          "key": "tool_temperature",
          "type": "number",
          "label": {
            "en": "Nozzle (°C)",
            "fr": "Buse (°C)",
            "de": "Düse (°C)",
            "es": "Boquilla (°C)"
          },
          "required": true,
          "default": 200,
          "min": 0,
          "max": 350
        },
        {
          "key": "bed_temperature",
          "type": "number",
          "label": {
            "en": "Bed (°C)",
            "fr": "Plateau (°C)",
            "de": "Druckbett (°C)",
            "es": "Cama (°C)"
          },
          "required": true,
          "default": 60,
          "min": 0,
          "max": 150
        }
      ],
      "outputs": [
        {
          "key": "applied",
          "type": "boolean",
          "label": {
            "en": "Applied",
            "fr": "Appliqué",
            "de": "Ausgeführt",
            "es": "Aplicado"
          }
        }
      ]
    },
    {
      "key": "cool_down",
      "label": {
        "en": "Turn the heaters off",
        "fr": "Couper les chauffes",
        "de": "Heizungen ausschalten",
        "es": "Apagar los calentadores"
      },
      "description": {
        "en": "Turns every heater off (TURN_OFF_HEATERS). Also during a print: the print would fail.",
        "fr": "Coupe toutes les chauffes (TURN_OFF_HEATERS). Aussi pendant une impression, qui échouerait alors.",
        "de": "Schaltet alle Heizungen aus (TURN_OFF_HEATERS). Auch während eines Drucks, der dann misslingt.",
        "es": "Apaga todos los calentadores (TURN_OFF_HEATERS). También durante una impresión, que fallaría."
      },
      "timeout_seconds": 20,
